<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Atlas leaves the phone through Android's cloud backup or device-to-device transfer:
     your notes, money, keys and chats stay here. Use Settings › Backup to export it yourself. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
