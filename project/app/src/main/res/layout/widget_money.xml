<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/money_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="SPENT TODAY" android:textColor="#8C96AC" android:textSize="11sp" android:letterSpacing="0.08" />
    <TextView android:id="@+id/money_today" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="—" android:textColor="#EDEFF5" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/money_month" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="—" android:textColor="#D4A24C" android:textSize="13sp" />
    <TextView android:id="@+id/money_add" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="+ Add expense" android:textColor="#4FC3A1" android:textSize="13sp" />
</LinearLayout>
