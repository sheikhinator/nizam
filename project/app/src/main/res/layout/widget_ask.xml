<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ask_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="8dp"
    android:background="@drawable/widget_pill">
    <TextView android:id="@+id/ask_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:text="Ask Atlas anything" android:textColor="#B8BFCC" android:textSize="15sp" android:maxLines="1" />
    <ImageView android:id="@+id/ask_scan" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
        android:src="@android:drawable/ic_menu_camera" android:tint="#EDEFF5" android:contentDescription="Scan" />
    <ImageView android:id="@+id/ask_mic" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
        android:src="@android:drawable/ic_btn_speak_now" android:tint="#4FC3A1" android:contentDescription="Talk" />
</LinearLayout>
