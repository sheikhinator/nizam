<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Atlas" android:textColor="#8C96AC" android:textSize="11sp" android:letterSpacing="0.08" />
    <TextView android:id="@+id/w_prayer" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="—" android:textColor="#EDEFF5" android:textSize="18sp" />
    <TextView android:id="@+id/w_missions" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="—" android:textColor="#4FC3A1" android:textSize="13sp" />
    <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:text="—" android:textColor="#E0B14A" android:textSize="13sp" />
</LinearLayout>
